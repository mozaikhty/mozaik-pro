rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Yalnızca giriş yapmış kullanıcılar işlem yapabilir
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Yalnızca resim dosyalarına izin ver
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // Resim veya video dosyalarına izin ver
    function isMedia() {
      return request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/mp4')
          || request.resource.contentType.matches('video/webm');
    }
    
    // Gönderi medyası: max 10 MB (görsel + video)
    function isPostSize() {
      return request.resource.size <= 10 * 1024 * 1024;
    }

    // Profil fotoğrafları: max 5 MB
    function isProfileSize() {
      return request.resource.size <= 5 * 1024 * 1024;
    }

    // Hikâye medyası: max 25 MB (video desteği)
    function isStorySize() {
      return request.resource.size <= 25 * 1024 * 1024;
    }

    // Gönderi fotoğraf ve videoları (posts/)
    match /posts/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isMedia() && isPostSize();
    }

    // Profil ve Kapak fotoğrafları (avatars/, banners/)
    match /avatars/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImage() && isProfileSize();
    }
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImage() && isProfileSize();
    }

    // Sohbet içi medya (chats/)
    match /chats/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isMedia() && isPostSize();
    }

    // Hikayeler — fotoğraf + video (stories/)
    match /stories/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isMedia() && isStorySize();
    }
  }
}
