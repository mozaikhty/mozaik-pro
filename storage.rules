rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Yalnızca giriş yapmış kullanıcılar işlem yapabilir
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Dosya adının, yükleyen kullanıcının UID'si ile başlaması zorunludur
    function isOwner(fileName) {
      return fileName.matches(request.auth.uid + '_.*');
    }
    
    // Yalnızca güvenli resim dosyalarına izin ver
    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    // Resim veya video dosyalarına izin ver
    function isMedia() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
          || request.resource.contentType.matches('video/(mp4|webm|quicktime)');
    }
    
    // Gönderi ve sohbet medyası (Sıkıştırıldıktan sonra çok daha küçük, güvenlik için maks 20MB video, 5MB resim için ortalama bir limit koyuyoruz)
    function isPostSize() {
      return request.resource.size <= 20 * 1024 * 1024;
    }

    // Profil fotoğrafları (Sıkıştırılmış 300KB/600KB hedefine güveniyoruz, maks limit 2MB)
    function isProfileSize() {
      return request.resource.size <= 2 * 1024 * 1024;
    }

    // Hikaye medyası (Maks 20MB video)
    function isStorySize() {
      return request.resource.size <= 20 * 1024 * 1024;
    }

    // Gönderi fotoğraf ve videoları (posts/)
    match /posts/{fileName} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isOwner(fileName) && isMedia() && isPostSize();
      allow delete: if isAuthenticated() && isOwner(fileName);
    }

    // Profil ve Kapak fotoğrafları (avatars/, banners/)
    match /avatars/{fileName} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isOwner(fileName) && isImage() && isProfileSize();
      allow delete: if isAuthenticated() && isOwner(fileName);
    }
    match /banners/{fileName} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isOwner(fileName) && isImage() && isProfileSize();
      allow delete: if isAuthenticated() && isOwner(fileName);
    }

    // Sohbet içi medya (chats/)
    match /chats/{fileName} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isOwner(fileName) && isImage() && isPostSize();
      allow delete: if isAuthenticated() && isOwner(fileName);
    }

    // Hikayeler (stories/ ve story_videos/)
    match /stories/{fileName} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isOwner(fileName) && isImage() && isStorySize();
      allow delete: if isAuthenticated() && isOwner(fileName);
    }
    match /story_videos/{fileName} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isOwner(fileName) && request.resource.contentType.matches('video/(mp4|webm|quicktime)') && isStorySize();
      allow delete: if isAuthenticated() && isOwner(fileName);
    }
  }
}
