rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================
    // 1. GENEL KONTROL FONKSİYONLARI
    // =========================================
    
    function isLoggedIn() { 
      return request.auth != null; 
    }
    
    function isAdmin() { 
      return isLoggedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); 
    }
    
    function isOwner(email) { 
      return isLoggedIn() && request.auth.token.email == email; 
    }

    function getMyUsername() {
      // DİKKAT: Bunun çalışması için Firebase Auth'ta profilin 'displayName' veya 
      // custom claims kısmında kullanıcı adının set edilmiş olması gerekir.
      return request.auth.token.name; 
    }

    // =========================================
    // DİZİ (ARRAY) KORUMA FONKSİYONLARI
    // =========================================
    function isOnlyAddingOrRemovingMe(oldList, newList) {
      return (newList.removeAll(oldList) == [getMyUsername()] && oldList.removeAll(newList) == []) ||
             (oldList.removeAll(newList) == [getMyUsername()] && newList.removeAll(oldList) == []) ||
             (newList.removeAll(oldList) == [] && oldList.removeAll(newList) == []);
    }

    function isOnlyAddingMyComment(oldList, newList) {
      return (newList.removeAll(oldList).size() == 1 && newList.removeAll(oldList)[0].author == getMyUsername() && oldList.removeAll(newList).size() == 0) ||
             (oldList.removeAll(newList).size() == 1 && oldList.removeAll(newList)[0].author == getMyUsername() && newList.removeAll(oldList).size() == 0) ||
             (newList.removeAll(oldList).size() == 0 && oldList.removeAll(newList).size() == 0);
    }

    // =========================================
    // 2. ADMİNLER (ADMINS) KOLEKSİYONU
    // =========================================
    match /admins/{userId} {
      allow read: if isLoggedIn() && request.auth.uid == userId;
      allow write: if false; 
    }

    // =========================================
    // 3. KULLANICILAR (USERS) KOLEKSİYONU
    // =========================================
    match /users/{username} {
      allow read: if true;
      
      // ✅ DÜZELTME: Başkasının kullanıcı adını almayı engellemek için '&&' (ve) kullanıldı.
      allow create: if isLoggedIn() && 
                       !exists(/databases/$(database)/documents/users/$(username)) &&
                       (username == getMyUsername() && request.resource.data.email == request.auth.token.email);
      
      allow delete: if isAdmin() || username == getMyUsername();
      
      allow update: if isAdmin() || 
                       username == getMyUsername() || 
                       (
                         isLoggedIn() && 
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers', 'followRequests', 'following']) &&
                         isOnlyAddingOrRemovingMe(resource.data.get('followers', []), request.resource.data.get('followers', [])) &&
                         isOnlyAddingOrRemovingMe(resource.data.get('followRequests', []), request.resource.data.get('followRequests', [])) &&
                         isOnlyAddingOrRemovingMe(resource.data.get('following', []), request.resource.data.get('following', []))
                       );
    }

    // =========================================
    // 4. GÖNDERİLER (POSTS) KOLEKSİYONU
    // =========================================
    match /posts/{postId} {
      allow read: if isLoggedIn();
      
      // 🔥 FATURA KORUMASI: İçerik boyutu 280 karaktere indirildi
      allow create: if isOwner(request.resource.data.authorEmail) &&
                       request.resource.data.author == getMyUsername() &&
                       request.resource.data.get('content', '').size() <= 280;
                       
      allow delete: if isAdmin() || isOwner(resource.data.authorEmail);
      
      allow update: if isAdmin() || 
                       isOwner(resource.data.authorEmail) || 
                       (
                         isLoggedIn() && 
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'comments']) &&
                         isOnlyAddingOrRemovingMe(resource.data.get('likes', []), request.resource.data.get('likes', [])) &&
                         isOnlyAddingMyComment(resource.data.get('comments', []), request.resource.data.get('comments', []))
                       );
    }

    // =========================================
    // 5. SOHBETLER (CHATS & GROUPS) KOLEKSİYONU
    // =========================================
    match /chats/{chatId} {
      allow read, write: if isLoggedIn() && (isAdmin() || getMyUsername() in resource.data.participants || getMyUsername() in request.resource.data.participants);
      
      match /messages/{messageId} { 
        allow read: if isLoggedIn() && (isAdmin() || getMyUsername() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants); 
        
        // 🔥 FATURA KORUMASI: Mesaj metinlerine maksimum 1000 karakter sınırı eklendi
        allow create: if isLoggedIn() && 
                         getMyUsername() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                         request.resource.data.sender == getMyUsername() &&
                         (!('text' in request.resource.data) || request.resource.data.text.size() <= 1000);
                         
        allow delete: if isLoggedIn() && 
                         (isAdmin() || (getMyUsername() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants && resource.data.sender == getMyUsername()));
        
        allow update: if isLoggedIn() && 
                         getMyUsername() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                         (
                           (
                             resource.data.sender == getMyUsername() &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isEdited']) &&
                             request.time < resource.data.createdAt + duration.value(15, 'm')
                           )
                           ||
                           (
                             resource.data.sender != getMyUsername() &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
                           )
                         );
      }
      
      match /calls/{callId} {
        allow read, write: if isLoggedIn() && (isAdmin() || getMyUsername() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        match /{subcollection}/{docId} { 
          allow read, write: if isLoggedIn() && (isAdmin() || getMyUsername() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants); 
        }
      }
    }

    match /groups/{groupId} { 
      allow create: if isLoggedIn() && getMyUsername() in request.resource.data.members;
      allow read, update, delete: if isLoggedIn() && (isAdmin() || getMyUsername() in resource.data.members || getMyUsername() in request.resource.data.members); 
      
      match /messages/{messageId} { 
        allow read: if isLoggedIn() && (isAdmin() || getMyUsername() in get(/databases/$(database)/documents/groups/$(groupId)).data.members); 
        
        // 🔥 FATURA KORUMASI: Grup mesajlarına maksimum 1000 karakter sınırı eklendi
        allow create: if isLoggedIn() && 
                         getMyUsername() in get(/databases/$(database)/documents/groups/$(groupId)).data.members &&
                         request.resource.data.sender == getMyUsername() &&
                         (!('text' in request.resource.data) || request.resource.data.text.size() <= 1000);
                         
        allow delete: if isLoggedIn() && 
                         (isAdmin() || (getMyUsername() in get(/databases/$(database)/documents/groups/$(groupId)).data.members && resource.data.sender == getMyUsername()));
        
        allow update: if isLoggedIn() && 
                         getMyUsername() in get(/databases/$(database)/documents/groups/$(groupId)).data.members &&
                         (
                           (
                             resource.data.sender == getMyUsername() &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isEdited']) &&
                             request.time < resource.data.createdAt + duration.value(15, 'm')
                           )
                           ||
                           (
                             resource.data.sender != getMyUsername() &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
                           )
                         );
      }

      match /calls/{callId} {
        allow read, write: if isLoggedIn() && (isAdmin() || getMyUsername() in get(/databases/$(database)/documents/groups/$(groupId)).data.members);
        match /{subcollection}/{docId} { 
          allow read, write: if isLoggedIn() && (isAdmin() || getMyUsername() in get(/databases/$(database)/documents/groups/$(groupId)).data.members); 
        }
      }
    }

    // =========================================
    // 6. BİLDİRİMLER (NOTIFICATIONS) KOLEKSİYONU
    // =========================================
    match /notifications/{notifId} { 
      allow create: if isLoggedIn() && request.resource.data.sender == getMyUsername();
      allow read, update, delete: if isLoggedIn() && (isAdmin() || resource.data.recipient == getMyUsername()); 
    }

    // =========================================
    // 7. DESTEK TALEPLERİ (TICKETS) KOLEKSİYONU
    // =========================================
    match /tickets/{ticketId} {
      // ✅ DÜZELTME: Bilet oluştururken yazar zorunlu kılındı.
      // 🔥 FATURA KORUMASI: Destek mesajlarına 2000 karakter sınırı getirildi.
      allow create: if isLoggedIn() &&
                       request.resource.data.author == getMyUsername() &&
                       (!('message' in request.resource.data) || request.resource.data.message.size() <= 2000);
                       
      // ✅ DÜZELTME: Kullanıcının KENDİ destek taleplerini görebilmesi eklendi.
      allow read: if isAdmin() || (isLoggedIn() && resource.data.author == getMyUsername());
      
      allow update, delete: if isAdmin();
    }
    
    // =========================================
    // 8. HİKAYELER (STORIES) KOLEKSİYONU 
    // =========================================
    match /stories/{storyId} {
      allow read: if isLoggedIn();
      
      allow create: if isLoggedIn() && 
                       request.resource.data.author == getMyUsername() &&
                       request.resource.data.get('text', '').size() <= 500;
                       
      allow delete: if isAdmin() || resource.data.author == getMyUsername();
      
      allow update: if isAdmin() || 
                       resource.data.author == getMyUsername() || 
                       (
                         isLoggedIn() && 
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers', 'likes']) &&
                         isOnlyAddingOrRemovingMe(resource.data.get('viewers', []), request.resource.data.get('viewers', [])) &&
                         isOnlyAddingOrRemovingMe(resource.data.get('likes', []), request.resource.data.get('likes', []))
                       );
    }
  }
}