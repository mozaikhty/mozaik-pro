rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // YARDIMCI FONKSİYONLAR
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // E-posta ile sahiplik kontrolü (username bazlı dokümanlar için)
    function isEmailOwner() {
      return isAuthenticated() && resource.data.email == request.auth.token.email;
    }

    // 1. KULLANICILAR KOLEKSİYONU
    // Doküman ID'si kullanıcının 'username' bilgisidir.
    match /users/{username} {
      allow read: if isAuthenticated();
      
      // Kayıt anında oluşturma: temel alan doğrulamaları
      allow create: if isAuthenticated()
                    && request.resource.data.email is string
                    && request.resource.data.fullName is string
                    && request.resource.data.fullName.size() <= 50;
      
      // Güncelleme: Sadece kendi profilini güncelleyebilir
      // resource.data.email mevcut dokümanın email'i, request.auth.token.email ise giriş yapan kişi
      allow update: if isAuthenticated() 
                    && resource.data.email == request.auth.token.email
                    && (!('fullName' in request.resource.data) || request.resource.data.fullName.size() <= 50)
                    && (!('bio' in request.resource.data) || request.resource.data.bio.size() <= 250)
                    && (!('location' in request.resource.data) || request.resource.data.location.size() <= 50);
      
      // Silme: Sadece kendi hesabını silebilir
      allow delete: if isAuthenticated() && resource.data.email == request.auth.token.email;
    }
    
    // 2. GÖNDERİLER (POSTS) KOLEKSİYONU
    match /posts/{postId} {
      allow read: if isAuthenticated();
      
      // Gönderi oluştururken içerik karakter sınırı (maksimum 280 karakter)
      allow create: if isAuthenticated() 
                    && request.resource.data.content is string
                    && request.resource.data.content.size() <= 280;
                    
      // Güncelleme: İçerik düzenlemelerinde de 280 karakter sınırı geçerli
      // Beğeni ve yorum arrayUnion işlemleri için de izin verilir
      allow update: if isAuthenticated()
                    && (!('content' in request.resource.data) || request.resource.data.content.size() <= 280);
      
      // Silme: Sadece gönderi sahibi silebilir
      allow delete: if isAuthenticated() 
                    && resource.data.authorEmail == request.auth.token.email;
    }

    // 3. ÖZEL SOHBETLER (CHATS)
    match /chats/{chatId} {
      allow read, write: if isAuthenticated();
      
      // Mesajlar alt koleksiyonu (Maksimum 1000 karakter)
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        
        // Oluşturma: Metin 1000 karakteri aşamaz
        allow create: if isAuthenticated() 
                      && (!('text' in request.resource.data) || request.resource.data.text.size() <= 1000);
        
        // Güncelleme: Düzenlemede de 1000 karakter sınırı geçerli
        allow update: if isAuthenticated()
                      && (!('text' in request.resource.data) || request.resource.data.text.size() <= 1000);
        
        // Silme: Sadece mesajı gönderen silebilir
        allow delete: if isAuthenticated();
      }
      
      // WebRTC Arama Sinyalleri
      match /calls/{callId} {
        allow read, write: if isAuthenticated();
        match /{candidateCollection}/{candidateId} {
          allow read, write: if isAuthenticated();
        }
      }
    }

    // 4. GRUP SOHBETLERİ (GROUPS)
    match /groups/{groupId} {
      allow read, write: if isAuthenticated();
      
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        
        allow create: if isAuthenticated() 
                      && (!('text' in request.resource.data) || request.resource.data.text.size() <= 1000);
        
        // Güncelleme: Düzenlemede de 1000 karakter sınırı
        allow update: if isAuthenticated()
                      && (!('text' in request.resource.data) || request.resource.data.text.size() <= 1000);
        
        allow delete: if isAuthenticated();
      }
      
      match /calls/{callId} {
        allow read, write: if isAuthenticated();
        match /{candidateCollection}/{candidateId} {
          allow read, write: if isAuthenticated();
        }
      }
    }

    // 5. BİLDİRİMLER (NOTIFICATIONS)
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      // Silme: Sadece bildirimin alıcısı silebilir
      allow delete: if isAuthenticated() 
                    && resource.data.recipient != null;
    }

    // 6. DESTEK TALEPLERİ (TICKETS)
    match /tickets/{ticketId} {
      // Oluşturma: Metin 2000 karakteri aşamaz
      allow create: if isAuthenticated() 
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 2000;
      // Okuma/güncelleme/silme: Giriş yapmış kullanıcılar
      allow read, update, delete: if isAuthenticated();
    }

    // 7. YÖNETİCİLER (ADMINS)
    // Sadece admin UID'leri okunabilir, istemci tarafından asla yazılamaz!
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if false; 
    }
  }
}
